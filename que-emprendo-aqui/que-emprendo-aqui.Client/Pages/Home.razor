@page "/"
@using MudBlazor

<PageTitle>¿Qué emprendo aquí?</PageTitle>

<section id="analizar" class="hero-new" style="background:#ffffff;">
    <div class="hero-glow"></div>

    <!-- Bloque de texto centrado -->
    <MudContainer MaxWidth="MaxWidth.Medium" Style="padding-top:5rem; padding-bottom:5rem; position:relative; z-index:1;">
        <div class="hero-center-block animate-fadein-up">

            <h1 class="hero-h1">No abras un negocio<br />a ciegas.</h1>

            <p class="hero-sub-new">
                Analizamos datos del INEGI y competencia local<br />
                para detectar oportunidades reales en tu ubicación.
            </p>

            <div class="hero-btn-row">
                <button class="hero-cta-primary">Analizar mi ubicación →</button>
            </div>

            <div class="hero-trust-row">
                <span>Basado en datos de</span>
                <strong>INEGI</strong>
                <span class="trust-sep">·</span>
                <strong>DENUE</strong>
                <span class="trust-sep">·</span>
                <span>+2.4M unidades analizadas</span>
            </div>

        </div>
    </MudContainer>

</section>

<!-- Cómo funciona -->
<section id="como-funciona" style="background:#fefce8; border-top:1px solid #fde68a; border-bottom:1px solid #fde68a;">
    <MudContainer MaxWidth="MaxWidth.ExtraLarge" Style="padding-top:4rem; padding-bottom:4rem;">

        <!-- Encabezado centrado -->
        <div style="text-align:center; margin-bottom:3rem;">
            <MudText Typo="Typo.overline" Style="color:#1e3a8a; font-weight:700; letter-spacing:0.1em;">
                CÓMO FUNCIONA
            </MudText>
            <MudText Typo="Typo.h4" Style="font-weight:900; color:#111827; margin-top:0.5rem; line-height:1.1; letter-spacing:-0.03em;">
                Tres pasos. Un resultado claro.
            </MudText>
            <MudText Typo="Typo.body1" Class="section-sub" Style="margin-top:0.4rem;">
                Sin experiencia. Sin suposiciones. Solo datos reales.
            </MudText>
        </div>

        <!-- Diagrama circular (desktop) / lista (mobile) -->
        <div class="circ-wrap">
            <div class="circ-diagram">

                <!-- Anillo decorativo -->
                <div class="circ-ring"></div>

                <!-- Centro: mock resultado -->
                <div class="circ-center">
                    <div class="circ-center-label">Tu resultado</div>
                    <div class="circ-center-emoji"><i class="ph-light ph-coffee"></i></div>
                    <div class="circ-center-name">Cafetería de barrio</div>
                    <div class="circ-center-score">87% viable</div>
                    <div class="circ-center-inv">~$18,000 MXN</div>
                </div>

                <!-- Paso 1: arriba -->
                <div class="circ-step circ-step-top">
                    <div class="circ-step-icon"><i class="ph-light ph-map-pin"></i></div>
                    <div class="circ-step-title">Selecciona tu zona</div>
                    <div class="circ-step-desc">Detectamos oportunidades cercanas automáticamente.</div>
                </div>

                <!-- Paso 2: abajo izquierda -->
                <div class="circ-step circ-step-left">
                    <div class="circ-step-icon"><i class="ph-light ph-wallet"></i></div>
                    <div class="circ-step-title">Define tu presupuesto</div>
                    <div class="circ-step-desc">No importa cuánto tienes, importa dónde lo pones.</div>
                </div>

                <!-- Paso 3: abajo derecha -->
                <div class="circ-step circ-step-right">
                    <div class="circ-step-icon"><i class="ph-light ph-chart-line-up"></i></div>
                    <div class="circ-step-title">Recibe oportunidades reales</div>
                    <div class="circ-step-desc">Con score de viabilidad e inversión estimada.</div>
                </div>

            </div>
        </div>

        <!-- Lista mobile (oculta en desktop) -->
        <div class="circ-mobile-list">
            <div class="circ-mobile-step">
                <span class="circ-mobile-icon"><i class="ph-light ph-map-pin"></i></span>
                <div>
                    <div class="circ-step-title">Selecciona tu zona</div>
                    <div class="circ-step-desc">Detectamos oportunidades cercanas automáticamente.</div>
                </div>
            </div>
            <div class="circ-mobile-step">
                <span class="circ-mobile-icon"><i class="ph-light ph-wallet"></i></span>
                <div>
                    <div class="circ-step-title">Define tu presupuesto</div>
                    <div class="circ-step-desc">No importa cuánto tienes, importa dónde lo pones.</div>
                </div>
            </div>
            <div class="circ-mobile-step">
                <span class="circ-mobile-icon"><i class="ph-light ph-chart-line-up"></i></span>
                <div>
                    <div class="circ-step-title">Recibe oportunidades reales</div>
                    <div class="circ-step-desc">Con score de viabilidad e inversión estimada.</div>
                </div>
            </div>
        </div>

    </MudContainer>
</section>

<!-- Por qué importa -->
<section style="background:#ffffff; padding:5rem 0;">
    <MudContainer MaxWidth="MaxWidth.ExtraLarge">

        <div style="text-align:center; margin-bottom:3rem;">
            <MudText Typo="Typo.overline" Style="color:#1e3a8a; font-weight:700; letter-spacing:0.12em;">
                POR QUÉ IMPORTA
            </MudText>
            <MudText Typo="Typo.h4" Style="font-weight:900; color:#111827; margin-top:0.5rem; line-height:1.15; letter-spacing:-0.03em;">
                El 75% de los negocios cierran antes del 2° año.
            </MudText>
            <MudText Typo="Typo.body1" Class="section-sub" Style="margin-top:0.75rem;">
                La mayoría no falla por mala ejecución — falla por elegir el negocio equivocado para el lugar equivocado. Aquí lo evitas.
            </MudText>
        </div>

        <!-- Stats centradas -->
        <div class="stats-grid">
            <div class="stat-card">
                <div class="stat-value">75%</div>
                <div class="stat-label">de negocios en México cierran antes de cumplir 2 años de operación.</div>
            </div>
            <div class="stat-card">
                <div class="stat-value">2.4M</div>
                <div class="stat-label">de unidades económicas del INEGI que usamos para el análisis.</div>
            </div>
            <div class="stat-card">
                <div class="stat-value">~30s</div>
                <div class="stat-label">es el tiempo promedio que tarda el análisis en mostrarte oportunidades reales en tu zona.</div>
            </div>
        </div>

    </MudContainer>
</section>

<!-- CTA Banner -->
<section style="background:#ffffff; padding:2rem 0 4rem;">
    <MudContainer MaxWidth="MaxWidth.ExtraLarge">
        <div class="cta-banner">
            <div style="display:flex; flex-wrap:wrap; align-items:center; justify-content:space-between; gap:3rem; padding:3rem 3.5rem;">

                <!-- Texto -->
                <div style="max-width:480px;">
                    <MudText Typo="Typo.h4" Style="font-weight:800; color:white; margin-bottom:0.75rem; letter-spacing:-0.02em; line-height:1.15;">
                        Encuentra un negocio viable en tu zona.
                    </MudText>
                    <MudText Typo="Typo.body1" Class="section-sub-inverse">
                        Analizamos datos reales y te mostramos solo lo que tiene sentido para tu ubicación y tu presupuesto.
                    </MudText>
                </div>

                <!-- Botón + trust signals -->
                <div style="display:flex; flex-direction:column; align-items:flex-start; gap:1rem;">
                    <button class="cta-primary-btn">
                        Analizar mi ubicación <span class="cta-arrow">→</span>
                    </button>
                    <div style="display:flex; flex-direction:column; gap:0.3rem;">
                        <span style="color:rgba(255,255,255,0.45); font-size:0.78rem;">✔ Basado en datos reales del INEGI</span>
                        <span style="color:rgba(255,255,255,0.45); font-size:0.78rem;">✔ Resultados en segundos</span>
                    </div>
                </div>

            </div>
        </div>
    </MudContainer>
</section>

<!-- Footer -->
<footer style="background:#fefce8; border-top:1px solid #fde68a; padding:2rem 0;">
    <MudContainer MaxWidth="MaxWidth.ExtraLarge">
        <div style="display:flex; flex-wrap:wrap; align-items:flex-start; justify-content:space-between; gap:1rem;">
            <!-- Marca -->
            <div>
                <MudText Typo="Typo.body1" Style="font-weight:700; color:#111827;">¿Qué emprendo aquí?</MudText>
                <MudText Typo="Typo.caption" Style="color:#9ca3af; display:block; margin-top:0.2rem;">Hecho en México</MudText>
            </div>
            <!-- Legal -->
            <MudText Typo="Typo.caption" Style="color:#9ca3af;">
                © @DateTime.Now.Year · Datos públicos (INEGI)
            </MudText>
        </div>
    </MudContainer>
</footer>
