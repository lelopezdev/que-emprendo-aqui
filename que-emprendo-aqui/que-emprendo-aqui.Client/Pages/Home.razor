@page "/"
@using MudBlazor
@rendermode InteractiveWebAssembly

<PageTitle>¿Qué emprendo aquí?</PageTitle>

<section id="analizar" style="background:white;">
    <MudContainer MaxWidth="MaxWidth.ExtraLarge" Style="padding-top:5rem; padding-bottom:5rem;">
        <MudGrid Spacing="6" AlignItems="Center">

            <!-- Texto -->
            <MudItem xs="12" lg="6">
                <div class="animate-fadein-up" style="display:flex; flex-direction:column; gap:1.5rem;">

                    <MudText Typo="Typo.h3" Class="hero-text" Style="font-weight:800; line-height:1.2; color:#111827;">
                        Antes de invertir,<br />
                        ¿Sabes <span style="color:#1e3a8a;">qué negocio<br /> funciona</span> en tu zona?
                    </MudText>

                    <MudText Typo="Typo.body1" Class="hero-text" Style="color:#6b7280; line-height:1.6;">
                        Cruzamos datos del INEGI con análisis de IA para decirte qué tipo
                        de negocio tiene mayor probabilidad de éxito en tu colonia, según
                        tu presupuesto y la competencia local.
                    </MudText>

                    <div class="hero-buttons">
                        <MudButton Variant="Variant.Filled" Color="Color.Primary"
                                   StartIcon="@Icons.Material.Filled.Search"
                                   Style="border-radius:0.75rem; text-transform:none; padding:0.5rem 1.5rem;">
                            Analizar mi zona
                        </MudButton>
                        <MudButton Variant="Variant.Text" Color="Color.Default"
                                   EndIcon="@Icons.Material.Filled.ArrowForward"
                                   Style="border-radius:0.75rem; text-transform:none;">
                            Ver cómo funciona
                        </MudButton>
                    </div>

                    <div class="mobile-tags">
                        <span class="tag-pill">☕ Cafetería</span>
                        <span class="tag-pill">🧺 Lavandería</span>
                        <span class="tag-pill">✂️ Estética</span>
                        <span class="tag-pill">🛒 Abarrotes</span>
                        <span class="tag-pill">🍽️ Lonchería</span>
                    </div>

                </div>
            </MudItem>

            <!-- Ilustración (solo desktop) -->
            <MudItem xs="12" lg="6">
                <div class="illustration-col animate-fadein-up"
                     style="animation-delay:0.25s; position:relative; justify-content:center; align-items:center; height:460px;">

                    <div style="position:absolute; width:400px; height:400px; border-radius:50%; background:radial-gradient(circle,#dbeafe 0%,#eff6ff 55%,transparent 80%);"></div>

                    <dotlottie-wc src="https://lottie.host/79cb7df6-4e85-4d96-9567-a896c7f2fdff/oaz7fAq7vU.lottie"
                                  style="width:400px;height:400px;position:relative;z-index:2;"
                                  autoplay loop>
                    </dotlottie-wc>

                    <!-- Tags flotantes -->
                    <div class="animate-float tag-pill" style="animation-delay:0s;   position:absolute; top:8%;    left:8%;   z-index:10; box-shadow:0 4px 6px -1px rgba(0,0,0,.1); white-space:nowrap;"><span>☕</span> Cafetería</div>
                    <div class="animate-float tag-pill" style="animation-delay:0.7s; position:absolute; top:3%;    right:4%;  z-index:10; box-shadow:0 4px 6px -1px rgba(0,0,0,.1); white-space:nowrap;"><span>🧺</span> Lavandería</div>
                    <div class="animate-float tag-pill" style="animation-delay:1.5s; position:absolute; top:43%;   right:1%;  z-index:10; box-shadow:0 4px 6px -1px rgba(0,0,0,.1); white-space:nowrap;"><span>✂️</span> Estética <span style="color:#9ca3af; font-size:0.7rem;">✕</span></div>
                    <div class="animate-float tag-pill" style="animation-delay:2.3s; position:absolute; top:58%;   left:2%;   z-index:10; box-shadow:0 4px 6px -1px rgba(0,0,0,.1); white-space:nowrap;"><span>🛒</span> Abarrotes</div>
                    <div class="animate-float tag-pill" style="animation-delay:0.4s; position:absolute; bottom:16%; right:8%; z-index:10; box-shadow:0 4px 6px -1px rgba(0,0,0,.1); white-space:nowrap;"><span>🍽️</span> Lonchería</div>

                    <!-- Destellos -->
                    <span class="animate-sparkle" style="animation-delay:0s;   position:absolute; top:24%;    left:44%;  z-index:5; color:#fbbf24; font-size:1.125rem; line-height:1;">✦</span>
                    <span class="animate-sparkle" style="animation-delay:1.3s; position:absolute; top:62%;    right:23%; z-index:5; color:#fbbf24; font-size:1.125rem; line-height:1;">✦</span>
                    <span class="animate-sparkle" style="animation-delay:2.1s; position:absolute; bottom:34%; left:18%;  z-index:5; color:#fbbf24; font-size:1.125rem; line-height:1;">✦</span>

                </div>
            </MudItem>

        </MudGrid>
    </MudContainer>
</section>

<!-- Cómo funciona -->
<section id="como-funciona" style="background:#f8fafc; border-top:1px solid #e5e7eb; border-bottom:1px solid #e5e7eb;">
    <MudContainer MaxWidth="MaxWidth.ExtraLarge" Style="padding-top:4rem; padding-bottom:4rem;">

        <!-- Encabezado -->
        <div style="margin-bottom:3rem;">
            <MudText Typo="Typo.overline" Style="color:#1e3a8a; font-weight:700; letter-spacing:0.1em;">
                CÓMO FUNCIONA
            </MudText>
            <MudText Typo="Typo.h4" Style="font-weight:900; color:#111827; margin-top:0.5rem; max-width:640px; line-height:1.1; letter-spacing:-0.03em;">
                Invierte en negocios rentables en tu zona,
            </MudText>
            <MudText Typo="Typo.h5" Style="font-weight:400; color:#9ca3af; margin-top:0.2rem; max-width:560px; line-height:1.3; letter-spacing:-0.01em;">
                Sin experiencia. Sin suposiciones. Solo datos reales.
            </MudText>
        </div>

        <!-- Cards con conectores -->
        <div class="steps-container">

            <!-- Card 01: icono eliminado, número es el anchor -->
            <div class="step-card-wrap">
                <MudPaper Elevation="0" Class="step-card" Style="border:1px solid #e5e7eb; border-radius:1rem; padding:2rem 2rem 1.75rem; background:white; position:relative; overflow:hidden;">
                    <span class="step-number" style="position:absolute; top:0.5rem; right:1rem; font-size:5rem; font-weight:900; color:#f1f5f9; line-height:1; user-select:none; pointer-events:none;">01</span>
                    <div style="padding-top:3rem;">
                        <MudText Typo="Typo.h6" Style="font-weight:700; color:#111827; margin-bottom:0.5rem; letter-spacing:-0.02em;">
                            Selecciona tu zona
                        </MudText>
                        <MudText Typo="Typo.body2" Style="color:#6b7280; line-height:1.65;">
                            Detectamos oportunidades cercanas automáticamente.
                        </MudText>
                        <span class="step-micro-cta">→ Permitir ubicación</span>
                    </div>
                </MudPaper>
            </div>

            <div class="step-arrow">›</div>

            <!-- Card 02 -->
            <div class="step-card-wrap">
                <MudPaper Elevation="0" Class="step-card" Style="border:1px solid #e5e7eb; border-radius:1rem; padding:2rem 2rem 1.75rem; background:white; position:relative; overflow:hidden;">
                    <span class="step-number" style="position:absolute; top:0.5rem; right:1rem; font-size:5rem; font-weight:900; color:#f1f5f9; line-height:1; user-select:none; pointer-events:none;">02</span>
                    <div style="padding-top:3rem;">
                        <MudText Typo="Typo.h6" Style="font-weight:700; color:#111827; margin-bottom:0.5rem; letter-spacing:-0.02em;">
                            Define tu presupuesto
                        </MudText>
                        <MudText Typo="Typo.body2" Style="color:#6b7280; line-height:1.65;">
                            Desde $5,000 hasta $100,000 MXN. Solo te mostramos lo que puedes pagar.
                        </MudText>
                        <span class="step-micro-cta">→ Ajustar presupuesto</span>
                    </div>
                </MudPaper>
            </div>

            <div class="step-arrow">›</div>

            <!-- Card 03: featured + elevada en desktop (rompe grid) -->
            <div class="step-card-wrap step-card-featured-wrap">
                <MudPaper Elevation="0" Class="step-card step-card-featured" Style="border:1px solid #3b82f6; border-radius:1rem; padding:2rem 2rem 1.75rem; position:relative; overflow:hidden;">
                    <span class="step-number" style="position:absolute; top:0.5rem; right:1rem; font-size:5rem; font-weight:900; color:#dbeafe; line-height:1; user-select:none; pointer-events:none;">03</span>
                    <div style="padding-top:3rem;">
                        <MudText Typo="Typo.h6" Style="font-weight:700; color:#1e3a8a; margin-bottom:0.5rem; letter-spacing:-0.02em;">
                            Recibe 3 oportunidades reales
                        </MudText>
                        <MudText Typo="Typo.body2" Style="color:#6b7280; line-height:1.65;">
                            Con score de viabilidad, inversión estimada y análisis de IA.
                        </MudText>
                        <span class="step-micro-cta">→ Ver mis oportunidades</span>
                    </div>
                </MudPaper>
            </div>

        </div>

    </MudContainer>
</section>

<!-- Por qué importa -->
<section style="background:#f8fafc; padding:5rem 0;">
    <MudContainer MaxWidth="MaxWidth.ExtraLarge">

        <div style="margin-bottom:2.5rem;">
            <MudText Typo="Typo.overline" Style="color:#1e3a8a; font-weight:700; letter-spacing:0.12em;">
                POR QUÉ IMPORTA
            </MudText>
            <MudText Typo="Typo.h4" Style="font-weight:900; color:#111827; margin-top:0.5rem; max-width:560px; line-height:1.15; letter-spacing:-0.03em;">
                El 75% de los negocios cierran antes del 2° año.
            </MudText>
            <MudText Typo="Typo.body1" Style="color:#6b7280; margin-top:0.75rem; max-width:500px; line-height:1.65;">
                La mayoría no falla por mala ejecución — falla por elegir el negocio equivocado para el lugar equivocado. Aquí lo evitas.
            </MudText>
        </div>

        <!-- Stats: composición tipográfica -->
        <div class="stats-card">
            <div class="stats-grid">

                <!-- Izquierda: protagonista -->
                <div class="stats-divider" style="padding:3.5rem 3rem 3.5rem; border-right:1px solid #f1f5f9;">
                    <div class="stat-hero-number">75%</div>
                    <div style="color:#9ca3af; font-size:0.875rem; margin-top:1.25rem; max-width:220px; line-height:1.55;">
                        de negocios cierran antes del año 2 en México
                    </div>
                </div>

                <!-- Derecha: contexto -->
                <div style="padding:3.5rem 2.5rem; display:flex; flex-direction:column; justify-content:space-between; gap:2rem;">
                    <div>
                        <div style="font-size:1.75rem; font-weight:700; color:#374151; letter-spacing:-0.03em; line-height:1;">2.4M</div>
                        <div style="color:#9ca3af; font-size:0.8rem; margin-top:0.5rem; line-height:1.5; max-width:160px;">unidades económicas en la base del INEGI</div>
                    </div>
                    <div>
                        <div style="font-size:1.75rem; font-weight:700; color:#374151; letter-spacing:-0.03em; line-height:1;">~30s</div>
                        <div style="color:#9ca3af; font-size:0.8rem; margin-top:0.5rem; line-height:1.5; max-width:160px;">tiempo promedio del análisis</div>
                    </div>
                </div>

            </div>
        </div>

    </MudContainer>
</section>

<!-- CTA Banner -->
<section style="background:#f8fafc; padding:2rem 0 4rem;">
    <MudContainer MaxWidth="MaxWidth.ExtraLarge">
        <div class="cta-banner">
            <div style="display:flex; flex-wrap:wrap; align-items:center; justify-content:space-between; gap:3rem; padding:3rem 3.5rem;">

                <!-- Texto -->
                <div style="max-width:480px;">
                    <MudText Typo="Typo.h4" Style="font-weight:800; color:white; margin-bottom:0.75rem; letter-spacing:-0.02em; line-height:1.15;">
                        Encuentra un negocio viable en tu zona.
                    </MudText>
                    <MudText Typo="Typo.body1" Style="color:rgba(255,255,255,0.58); line-height:1.6;">
                        Analizamos datos reales y te mostramos solo lo que tiene sentido para tu colonia y tu presupuesto.
                    </MudText>
                </div>

                <!-- Botón + trust signals -->
                <div style="display:flex; flex-direction:column; align-items:flex-start; gap:1rem;">
                    <button class="cta-primary-btn">
                        Analizar mi zona <span class="cta-arrow">→</span>
                    </button>
                    <div style="display:flex; flex-direction:column; gap:0.3rem;">
                        <span style="color:rgba(255,255,255,0.45); font-size:0.78rem;">✔ Basado en datos reales del INEGI</span>
                        <span style="color:rgba(255,255,255,0.45); font-size:0.78rem;">✔ Resultados en segundos</span>
                    </div>
                </div>

            </div>
        </div>
    </MudContainer>
</section>

<!-- Footer -->
<footer style="background:#f8fafc; border-top:1px solid #e5e7eb; padding:2rem 0;">
    <MudContainer MaxWidth="MaxWidth.ExtraLarge">
        <div style="display:flex; flex-wrap:wrap; align-items:flex-start; justify-content:space-between; gap:1rem;">
            <!-- Marca -->
            <div>
                <MudText Typo="Typo.body1" Style="font-weight:700; color:#111827;">¿Qué emprendo aquí?</MudText>
                <MudText Typo="Typo.caption" Style="color:#9ca3af; display:block; margin-top:0.2rem;">Hecho en México</MudText>
            </div>
            <!-- Legal -->
            <MudText Typo="Typo.caption" Style="color:#9ca3af;">
                © @DateTime.Now.Year · Datos públicos (INEGI)
            </MudText>
        </div>
    </MudContainer>
</footer>
