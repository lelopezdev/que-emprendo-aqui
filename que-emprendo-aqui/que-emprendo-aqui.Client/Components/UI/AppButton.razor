@if (!string.IsNullOrEmpty(Href))
{
    <a href="@Href"
       target="@Target"
       class="@CssClasses">
        @if (Icon is not null)
        {
            <span class="shrink-0">@Icon</span>
        }
        @if (!string.IsNullOrEmpty(Label))
        {
            <span>@Label</span>
        }
        @ChildContent
    </a>
}
else
{
    <button type="@Type"
            disabled="@Disabled"
            @onclick="OnClick"
            class="@CssClasses">
        @if (Icon is not null)
        {
            <span class="shrink-0">@Icon</span>
        }
        @if (!string.IsNullOrEmpty(Label))
        {
            <span>@Label</span>
        }
        @ChildContent
    </button>
}

@code {
    [Parameter] public string? Href { get; set; }
    [Parameter] public string Target { get; set; } = "_self";
    [Parameter] public string? Label { get; set; }
    [Parameter] public RenderFragment? Icon { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }

    [Parameter] public ButtonVariant Variant { get; set; } = ButtonVariant.Primary;
    [Parameter] public ButtonSize Size { get; set; } = ButtonSize.Md;
    [Parameter] public bool Outline { get; set; } = false;
    [Parameter] public bool Disabled { get; set; } = false;
    [Parameter] public bool FullWidth { get; set; } = false;
    [Parameter] public string Type { get; set; } = "button";
    [Parameter] public string? Class { get; set; }

    [Parameter] public EventCallback OnClick { get; set; }

    private string CssClasses => string.Join(" ", BuildClasses()).Trim();

    private IEnumerable<string> BuildClasses()
    {
        yield return "btn";
        yield return "inline-flex items-center gap-2";

        yield return Variant switch
        {
            ButtonVariant.Primary   => Outline ? "btn-outline btn-primary"   : "btn-primary",
            ButtonVariant.Secondary => Outline ? "btn-outline btn-secondary" : "btn-secondary",
            ButtonVariant.Accent    => Outline ? "btn-outline btn-accent"    : "btn-accent",
            ButtonVariant.Ghost     => "btn-ghost",
            ButtonVariant.Neutral   => Outline ? "btn-outline btn-neutral"   : "btn-neutral",
            ButtonVariant.Error     => Outline ? "btn-outline btn-error"     : "btn-error",
            _                       => "btn-primary"
        };

        yield return Size switch
        {
            ButtonSize.Xs => "btn-xs",
            ButtonSize.Sm => "btn-sm",
            ButtonSize.Md => "",
            ButtonSize.Lg => "btn-lg",
            ButtonSize.Xl => "btn-xl",
            _             => ""
        };

        if (FullWidth) yield return "w-full";
        if (Disabled)  yield return "btn-disabled";
        if (!string.IsNullOrEmpty(Class)) yield return Class;
    }

    public enum ButtonVariant { Primary, Secondary, Accent, Ghost, Neutral, Error }
    public enum ButtonSize    { Xs, Sm, Md, Lg, Xl }
}
