@page "/"
@using MudBlazor
@using que_emprendo_aqui.Client.Components.UI
@rendermode InteractiveWebAssembly

<PageTitle>¿Qué emprendo aquí?</PageTitle>

<!-- Hero -->
<section id="analizar" class="bg-white">
    <div class="max-w-6xl mx-auto px-6 py-20 lg:py-28 grid grid-cols-1 lg:grid-cols-2 gap-12 items-center">

        <!-- Texto -->
        <div class="animate-fadein-up space-y-6">

            <h1 class="text-4xl sm:text-5xl font-extrabold leading-tight text-gray-900 text-center lg:text-left">
                Antes de invertir,<br />
                ¿Sabes <span class="text-blue-900">qué negocio<br class="hidden sm:block" /> funciona</span> en tu zona?
            </h1>

            <p class="text-gray-500 text-base leading-relaxed max-w-md mx-auto lg:mx-0 text-center lg:text-left">
                Cruzamos datos del INEGI con análisis de IA para decirte qué tipo
                de negocio tiene mayor probabilidad de éxito en tu colonia, según
                tu presupuesto y la competencia local.
            </p>

            <div class="flex flex-col sm:flex-row gap-3 justify-center lg:justify-start">
                <AppButton Label="Analizar mi zona" Class="rounded-xl px-6 shadow-sm">
                    <Icon><MudIcon Icon="@Icons.Material.Filled.Search" /></Icon>
                </AppButton>
                <AppButton Label="Ver cómo funciona" Variant="AppButton.ButtonVariant.Ghost"
                           Class="rounded-xl font-medium">
                    <Icon><MudIcon Icon="@Icons.Material.Filled.ArrowForward" /></Icon>
                </AppButton>
            </div>

            <!-- Tags visibles solo en móvil / tablet -->
            <div class="flex flex-wrap gap-2 justify-center lg:hidden pt-1">
                <span class="tag-pill">☕ Cafetería</span>
                <span class="tag-pill">🧺 Lavandería</span>
                <span class="tag-pill">✂️ Estética</span>
                <span class="tag-pill">🛒 Abarrotes</span>
                <span class="tag-pill">🍽️ Lonchería</span>
            </div>

        </div>

        <!-- Ilustración (solo desktop) -->
        <div class="hidden lg:flex animate-fadein-up [animation-delay:0.25s] relative justify-center items-center h-[460px]">

            <div class="absolute w-[360px] h-[360px] rounded-full bg-[radial-gradient(circle,#dbeafe_0%,#eff6ff_55%,transparent_80%)]"></div>

            <dotlottie-wc src="https://lottie.host/79cb7df6-4e85-4d96-9567-a896c7f2fdff/oaz7fAq7vU.lottie"
                          style="width:380px;height:380px;"
                          autoplay loop
                          class="relative z-[2]">
            </dotlottie-wc>

            <!-- Tags flotantes -->
            <div class="animate-float [animation-delay:0s]   absolute top-[8%]  left-[8%]  z-10 tag-pill shadow-md whitespace-nowrap"><span>☕</span> Cafetería</div>
            <div class="animate-float [animation-delay:0.7s] absolute top-[3%]  right-[4%] z-10 tag-pill shadow-md whitespace-nowrap"><span>🧺</span> Lavandería</div>
            <div class="animate-float [animation-delay:1.5s] absolute top-[43%] right-[1%] z-10 tag-pill shadow-md whitespace-nowrap"><span>✂️</span> Estética <span class="text-gray-400 text-[0.7rem]">✕</span></div>
            <div class="animate-float [animation-delay:2.3s] absolute top-[58%] left-[2%]  z-10 tag-pill shadow-md whitespace-nowrap"><span>🛒</span> Abarrotes</div>
            <div class="animate-float [animation-delay:0.4s] absolute bottom-[16%] right-[8%] z-10 tag-pill shadow-md whitespace-nowrap"><span>🍽️</span> Lonchería</div>

            <!-- Destellos -->
            <span class="animate-sparkle [animation-delay:0s]   absolute top-[24%]   left-[44%] z-[5] text-amber-400 text-lg leading-none">✦</span>
            <span class="animate-sparkle [animation-delay:1.3s] absolute top-[62%]   right-[23%] z-[5] text-amber-400 text-lg leading-none">✦</span>
            <span class="animate-sparkle [animation-delay:2.1s] absolute bottom-[34%] left-[18%] z-[5] text-amber-400 text-lg leading-none">✦</span>

        </div>

    </div>
</section>
